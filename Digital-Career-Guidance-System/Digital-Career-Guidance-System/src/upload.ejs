<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Upload Results' %> - DCGS</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #3b82f6;
            --bg: #f1f5f9;
            --card: #ffffff;
            --text: #1e293b;
            --text-light: #64748b;
            --border: #e2e8f0;
            --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
        }

        /* Navigation */
        .navbar {
            background: var(--card);
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 0;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow);
        }

        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 0.875rem;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .btn-back {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-light);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: color 0.2s;
        }

        .btn-back:hover {
            color: var(--primary);
        }

        .nav-user {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 0.5rem;
            transition: background 0.2s;
        }

        .nav-user:hover {
            background: var(--bg);
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 0.875rem;
        }

        .dropdown {
            position: relative;
        }

        .dropdown-menu {
            position: absolute;
            top: 100%;
            right: 0;
            margin-top: 0.5rem;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 0.75rem;
            box-shadow: var(--shadow-lg);
            min-width: 200px;
            display: none;
            overflow: hidden;
        }

        .dropdown-menu.active {
            display: block;
            animation: fadeIn 0.2s ease;
        }

        .dropdown-item {
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--text);
            text-decoration: none;
            font-size: 0.875rem;
            transition: background 0.2s;
        }

        .dropdown-item:hover {
            background: var(--bg);
        }

        .dropdown-divider {
            height: 1px;
            background: var(--border);
            margin: 0.5rem 0;
        }

        .dropdown-item.danger {
            color: var(--danger);
        }

        /* Main Layout */
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        .page-header {
            margin-bottom: 2rem;
        }

        .page-header h1 {
            font-size: 1.875rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .page-header p {
            color: var(--text-light);
        }

        /* Upload Steps */
        .steps {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2rem;
            position: relative;
        }

        .steps::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--border);
            z-index: 0;
        }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            position: relative;
            z-index: 1;
            background: var(--bg);
            padding: 0 1rem;
        }

        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--card);
            border: 2px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: var(--text-light);
            transition: all 0.3s;
        }

        .step.active .step-number {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
        }

        .step.completed .step-number {
            background: var(--success);
            border-color: var(--success);
            color: white;
        }

        .step-label {
            font-size: 0.875rem;
            color: var(--text-light);
            font-weight: 500;
        }

        .step.active .step-label {
            color: var(--primary);
        }

        /* Upload Zone */
        .upload-card {
            background: var(--card);
            border: 2px dashed var(--border);
            border-radius: 1rem;
            padding: 3rem;
            text-align: center;
            transition: all 0.3s;
            cursor: pointer;
        }

        .upload-card:hover {
            border-color: var(--primary);
            background: #f8fafc;
        }

        .upload-card.dragover {
            border-color: var(--primary);
            background: #eff6ff;
            transform: scale(1.02);
        }

        .upload-card.hidden {
            display: none;
        }

        .upload-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, #dbeafe, #bfdbfe);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
        }

        .upload-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .upload-desc {
            color: var(--text-light);
            margin-bottom: 1.5rem;
        }

        .upload-hint {
            font-size: 0.75rem;
            color: var(--text-light);
        }

        .file-input {
            display: none;
        }

        /* Preview Section */
        .preview-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 2rem;
            display: none;
        }

        .preview-card.active {
            display: block;
            animation: slideUp 0.3s ease;
        }

        .preview-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .file-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .file-icon {
            width: 48px;
            height: 48px;
            background: #fee2e2;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .file-details h3 {
            font-weight: 600;
            color: var(--text);
        }

        .file-details p {
            font-size: 0.875rem;
            color: var(--text-light);
        }

        .btn-remove {
            padding: 0.5rem 1rem;
            background: #fee2e2;
            color: var(--danger);
            border: none;
            border-radius: 0.5rem;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-remove:hover {
            background: #fecaca;
        }

        /* Processing Status */
        .processing-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 3rem;
            text-align: center;
            display: none;
        }

        .processing-card.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        .processing-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid #e2e8f0;
            border-top-color: var(--primary);
            border-radius: 50%;
            margin: 0 auto 1.5rem;
            animation: spin 1s linear infinite;
        }

        .processing-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .processing-desc {
            color: var(--text-light);
        }

        .progress-bar {
            height: 8px;
            background: var(--bg);
            border-radius: 9999px;
            overflow: hidden;
            margin-top: 1.5rem;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--primary-dark));
            border-radius: 9999px;
            width: 0%;
            transition: width 0.5s ease;
            animation: progressPulse 2s infinite;
        }

        @keyframes progressPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        /* Results Section */
        .results-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 2rem;
            display: none;
        }

        .results-card.active {
            display: block;
            animation: slideUp 0.5s ease;
        }

        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .aps-badge {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            padding: 1rem 2rem;
            border-radius: 1rem;
            text-align: center;
        }

        .aps-label {
            font-size: 0.875rem;
            opacity: 0.9;
        }

        .aps-value {
            font-size: 2.5rem;
            font-weight: 700;
        }

        .subject-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
        }

        .subject-table th {
            text-align: left;
            padding: 0.875rem;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--border);
            background: var(--bg);
        }

        .subject-table td {
            padding: 0.875rem;
            border-bottom: 1px solid var(--border);
        }

        .subject-table tr:hover td {
            background: #f8fafc;
        }

        .mark-input {
            width: 80px;
            padding: 0.5rem;
            border: 1px solid var(--border);
            border-radius: 0.375rem;
            text-align: center;
            font-weight: 600;
        }

        .mark-input:focus {
            outline: none;
            border-color: var(--primary);
        }

        .level-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .level-7 { background: #d1fae5; color: #065f46; }
        .level-6 { background: #dbeafe; color: #1e40af; }
        .level-5 { background: #fef3c7; color: #92400e; }
        .level-4 { background: #ffedd5; color: #9a3412; }
        .level-3 { background: #fee2e2; color: #991b1b; }
        .level-2 { background: #fecaca; color: #7f1d1d; }
        .level-1 { background: #f3f4f6; color: #374151; }

        .form-actions {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.875rem 1.5rem;
            border-radius: 0.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-secondary {
            background: var(--bg);
            color: var(--text);
            border: 1px solid var(--border);
        }

        .btn-secondary:hover {
            background: var(--border);
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* Alert */
        .alert {
            padding: 1rem 1.5rem;
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
            display: none;
            align-items: center;
            gap: 0.75rem;
        }

        .alert.active {
            display: flex;
            animation: slideIn 0.3s ease;
        }

        .alert-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .alert-success {
            background: #d1fae5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        /* Error State */
        .error-card {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 1rem;
            padding: 2rem;
            text-align: center;
            display: none;
        }

        .error-card.active {
            display: block;
            animation: shake 0.5s ease;
        }

        .error-icon {
            width: 60px;
            height: 60px;
            background: #fee2e2;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            font-size: 2rem;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-10px); }
            to { opacity: 1; transform: translateX(0); }
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        /* Mobile Responsive */
        @media (max-width: 640px) {
            .steps {
                display: none;
            }

            .upload-card {
                padding: 2rem 1rem;
            }

            .results-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .subject-table {
                font-size: 0.875rem;
            }

            .subject-table th,
            .subject-table td {
                padding: 0.5rem;
            }

            .form-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/dashboard" class="logo">
                <div class="logo-icon">D</div>
                DCGS
            </a>
            <div class="nav-right">
                <a href="/dashboard" class="btn-back">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    Back to Dashboard
                </a>
                <div class="dropdown">
                    <div class="nav-user" onclick="toggleDropdown()">
                        <div class="user-avatar" id="navAvatar">U</div>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>
                    <div class="dropdown-menu" id="userDropdown">
                        <a href="/profile" class="dropdown-item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            Profile Settings
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="#" class="dropdown-item danger" onclick="logout()">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Sign Out
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container">
        <div class="page-header">
            <h1>Upload Results</h1>
            <p>Upload your matric report card to calculate your APS score automatically.</p>
        </div>

        <!-- Alert -->
        <div class="alert alert-error" id="errorAlert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span id="errorMessage">Something went wrong. Please try again.</span>
        </div>

        <!-- Steps -->
        <div class="steps" id="steps">
            <div class="step active" data-step="1">
                <div class="step-number">1</div>
                <span class="step-label">Upload</span>
            </div>
            <div class="step" data-step="2">
                <div class="step-number">2</div>
                <span class="step-label">Processing</span>
            </div>
            <div class="step" data-step="3">
                <div class="step-number">3</div>
                <span class="step-label">Review</span>
            </div>
            <div class="step" data-step="4">
                <div class="step-number">4</div>
                <span class="step-label">Confirm</span>
            </div>
        </div>

        <!-- Upload Zone -->
        <div class="upload-card" id="uploadZone">
            <div class="upload-icon">📄</div>
            <h2 class="upload-title">Drop your report card here</h2>
            <p class="upload-desc">or click to browse from your device</p>
            <p class="upload-hint">Supports: JPG, PNG, PDF (max 10MB)</p>
            <input type="file" class="file-input" id="fileInput" accept=".jpg,.jpeg,.png,.pdf">
        </div>

        <!-- Preview -->
        <div class="preview-card" id="previewCard">
            <div class="preview-header">
                <div class="file-info">
                    <div class="file-icon" id="fileIcon">📄</div>
                    <div class="file-details">
                        <h3 id="fileName">filename.jpg</h3>
                        <p id="fileSize">2.5 MB</p>
                    </div>
                </div>
                <button class="btn-remove" onclick="removeFile()">Remove</button>
            </div>
            <button class="btn btn-primary" onclick="startUpload()" id="uploadBtn">
                Process Report Card
            </button>
        </div>

        <!-- Processing -->
        <div class="processing-card" id="processingCard">
            <div class="processing-spinner"></div>
            <h2 class="processing-title">Processing your report card...</h2>
            <p class="processing-desc">Our AI is extracting your subjects and marks. This may take a few moments.</p>
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill" style="width: 30%"></div>
            </div>
        </div>

        <!-- Error -->
        <div class="error-card" id="errorCard">
            <div class="error-icon">⚠️</div>
            <h3>Processing Failed</h3>
            <p id="errorDetails" style="color: #7f1d1d; margin: 1rem 0;">We couldn't read your report card. Please try uploading a clearer image.</p>
            <button class="btn btn-secondary" onclick="resetUpload()">Try Again</button>
        </div>

        <!-- Results -->
        <div class="results-card" id="resultsCard">
            <div class="results-header">
                <div>
                    <h2>Extracted Results</h2>
                    <p style="color: var(--text-light);">Review and edit if needed, then confirm to save.</p>
                </div>
                <div class="aps-badge">
                    <div class="aps-label">APS Score (Best 6)</div>
                    <div class="aps-value" id="apsValue">--</div>
                </div>
            </div>

            <table class="subject-table">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Mark (%)</th>
                        <th>Level</th>
                        <th>APS Points</th>
                    </tr>
                </thead>
                <tbody id="subjectsTable">
                    <!-- Populated by JS -->
                </tbody>
            </table>

            <div class="form-actions">
                <button class="btn btn-secondary" onclick="resetUpload()">Upload Different File</button>
                <button class="btn btn-primary" onclick="confirmResults()" id="confirmBtn">
                    Confirm & Save Results
                </button>
            </div>
        </div>
    </div>

    <script>
        // State
        let currentFile = null;
        let uploadId = null;
        let extractedData = null;
        let pollInterval = null;

        // User data
        const userData = <%- JSON.stringify(user || {}) %>;

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            const initial = (userData.first_name || userData.email || 'U')[0].toUpperCase();
            document.getElementById('navAvatar').textContent = initial;
        });

        // Toggle dropdown
        function toggleDropdown() {
            document.getElementById('userDropdown').classList.toggle('active');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.dropdown')) {
                document.getElementById('userDropdown').classList.remove('active');
            }
        });

        // Logout
        async function logout() {
            try {
                const response = await fetch('/api/auth/logout', {
                    method: 'POST',
                    credentials: 'include'
                });
                if (response.ok) window.location.href = '/';
            } catch (error) {
                console.error('Logout failed:', error);
            }
        }

        // File Upload Handling
        const uploadZone = document.getElementById('uploadZone');
        const fileInput = document.getElementById('fileInput');

        uploadZone.addEventListener('click', () => fileInput.click());
        
        uploadZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadZone.classList.add('dragover');
        });

        uploadZone.addEventListener('dragleave', () => {
            uploadZone.classList.remove('dragover');
        });

        uploadZone.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadZone.classList.remove('dragover');
            const files = e.dataTransfer.files;
            if (files.length) handleFile(files[0]);
        });

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length) handleFile(e.target.files[0]);
        });

        function handleFile(file) {
            // Validate
            const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg', 'application/pdf'];
            if (!allowedTypes.includes(file.type)) {
                showError('Invalid file type. Please upload JPG, PNG, or PDF.');
                return;
            }

            if (file.size > 10 * 1024 * 1024) {
                showError('File too large. Maximum size is 10MB.');
                return;
            }

            currentFile = file;
            
            // Show preview
            document.getElementById('fileName').textContent = file.name;
            document.getElementById('fileSize').textContent = formatFileSize(file.size);
            document.getElementById('fileIcon').textContent = file.type === 'application/pdf' ? '📑' : '🖼️';
            
            uploadZone.classList.add('hidden');
            document.getElementById('previewCard').classList.add('active');
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        function removeFile() {
            currentFile = null;
            fileInput.value = '';
            uploadZone.classList.remove('hidden');
            document.getElementById('previewCard').classList.remove('active');
        }

        function resetUpload() {
            removeFile();
            document.getElementById('processingCard').classList.remove('active');
            document.getElementById('resultsCard').classList.remove('active');
            document.getElementById('errorCard').classList.remove('active');
            updateStep(1);
            if (pollInterval) clearInterval(pollInterval);
        }

        function updateStep(step) {
            document.querySelectorAll('.step').forEach(s => {
                const stepNum = parseInt(s.dataset.step);
                s.classList.remove('active', 'completed');
                if (stepNum === step) s.classList.add('active');
                if (stepNum < step) s.classList.add('completed');
            });
        }

        function showError(message) {
            const alert = document.getElementById('errorAlert');
            document.getElementById('errorMessage').textContent = message;
            alert.classList.add('active');
            setTimeout(() => alert.classList.remove('active'), 5000);
        }

        // Start Upload & Processing
        async function startUpload() {
            if (!currentFile) return;

            updateStep(2);
            document.getElementById('previewCard').classList.remove('active');
            document.getElementById('processingCard').classList.add('active');

            const formData = new FormData();
            formData.append('reportCard', currentFile);

            try {
                const response = await fetch('/api/results/upload', {
                    method: 'POST',
                    credentials: 'include',
                    body: formData
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'Upload failed');
                }

                uploadId = data.uploadId;
                
                // Start polling for status
                pollInterval = setInterval(() => checkStatus(uploadId), 2000);
                
            } catch (error) {
                document.getElementById('processingCard').classList.remove('active');
                document.getElementById('errorCard').classList.add('active');
                document.getElementById('errorDetails').textContent = error.message;
            }
        }

        // Check processing status
        async function checkStatus(id) {
            try {
                const response = await fetch(`/api/results/status/${id}`, {
                    credentials: 'include'
                });
                
                const data = await response.json();

                // Update progress bar animation
                const progress = Math.min(30 + (Date.now() % 3) * 10, 90);
                document.getElementById('progressFill').style.width = progress + '%';

                if (data.status === 'completed') {
                    clearInterval(pollInterval);
                    extractedData = data;
                    displayResults(data);
                } else if (data.status === 'failed') {
                    clearInterval(pollInterval);
                    document.getElementById('processingCard').classList.remove('active');
                    document.getElementById('errorCard').classList.add('active');
                    document.getElementById('errorDetails').textContent = data.error || 'Processing failed. Please try a clearer image.';
                }
                // If still processing, continue polling
                
            } catch (error) {
                console.error('Status check failed:', error);
            }
        }

        // Display Results
        function displayResults(data) {
            updateStep(3);
            document.getElementById('processingCard').classList.remove('active');
            document.getElementById('resultsCard').classList.add('active');

            document.getElementById('apsValue').textContent = data.apsScore || '--';

            const tbody = document.getElementById('subjectsTable');
            tbody.innerHTML = '';

            if (data.subjects && data.subjects.length) {
                data.subjects.forEach((subject, index) => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td style="font-weight: 500;">${subject.subject}</td>
                        <td>
                            <input type="number" class="mark-input" value="${subject.mark}" 
                                min="0" max="100" onchange="updateMark(${index}, this.value)"
                                data-subject="${subject.subject}">
                        </td>
                        <td><span class="level-badge level-${subject.level}" id="level-${index}">Level ${subject.level}</span></td>
                        <td style="font-weight: 600; color: var(--primary);" id="aps-${index}">${subject.aps_points}</td>
                    `;
                    tbody.appendChild(row);
                });
            }
        }

        // Update mark manually
        function updateMark(index, newMark) {
            const mark = Math.max(0, Math.min(100, parseInt(newMark) || 0));
            const level = calculateLevel(mark);
            const aps = level; // APS points equal level in NSC

            // Update display
            document.getElementById(`level-${index}`).textContent = `Level ${level}`;
            document.getElementById(`level-${index}`).className = `level-badge level-${level}`;
            document.getElementById(`aps-${index}`).textContent = aps;

            // Update data
            if (extractedData && extractedData.subjects[index]) {
                extractedData.subjects[index].mark = mark;
                extractedData.subjects[index].level = level;
                extractedData.subjects[index].aps_points = aps;
            }

            // Recalculate total APS (best 6)
            recalculateAPS();
        }

        function calculateLevel(mark) {
            if (mark >= 80) return 7;
            if (mark >= 70) return 6;
            if (mark >= 60) return 5;
            if (mark >= 50) return 4;
            if (mark >= 40) return 3;
            if (mark >= 30) return 2;
            return 1;
        }

        function recalculateAPS() {
            if (!extractedData || !extractedData.subjects) return;

            // Sort by APS points descending, take best 6, exclude Life Orientation
            const subjects = [...extractedData.subjects]
                .filter(s => !s.subject.toLowerCase().includes('life orientation'))
                .sort((a, b) => b.aps_points - a.aps_points)
                .slice(0, 6);

            const totalAPS = subjects.reduce((sum, s) => sum + s.aps_points, 0);
            document.getElementById('apsValue').textContent = totalAPS;
        }

        // Confirm and save results
        async function confirmResults() {
            const btn = document.getElementById('confirmBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner" style="width: 16px; height: 16px; border-color: rgba(255,255,255,0.3); border-top-color: white;"></span> Saving...';

            try {
                const response = await fetch('/api/results/confirm', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        subjects: extractedData.subjects,
                        uploadId: uploadId
                    })
                });

                const data = await response.json();

                if (response.ok) {
                    updateStep(4);
                    // Redirect to dashboard after short delay
                    setTimeout(() => {
                        window.location.href = '/dashboard?success=results-saved';
                    }, 1500);
                } else {
                    throw new Error(data.error || 'Failed to save results');
                }
            } catch (error) {
                btn.disabled = false;
                btn.textContent = 'Confirm & Save Results';
                showError(error.message);
            }
        }
    </script>
</body>
</html>