<div class="mobile-overlay" id="mobileOverlay" onclick="closeMobileMenu()"></div>
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">D</div>
        <div>
            <div class="sidebar-brand-name">DCGS</div>
            <div class="sidebar-brand-sub">Career Guidance</div>
        </div>
    </div>

    <nav class="sidebar-content">
        <ul class="sidebar-menu">
            <li>
                <a href="/dashboard" class="sidebar-menu-button <%= activePage === 'dashboard' ? 'active' : '' %>">
                    <div class="sidebar-menu-left">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
                            <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        </svg>
                        <span>Dashboard</span>
                    </div>
                </a>
            </li>
            <li>
                <a href="/upload" class="sidebar-menu-button <%= activePage === 'upload' ? 'active' : '' %>">
                    <div class="sidebar-menu-left">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        <span>Upload Results</span>
                    </div>
                    <span class="sidebar-nav-badge <%= user && user.has_results ? 'hidden' : '' %>" id="uploadBadge">New</span>
                </a>
            </li>
            <li>
                <a href="/recommendations" class="sidebar-menu-button <%= activePage === 'recommendations' ? 'active' : '' %>">
                    <div class="sidebar-menu-left">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                        <span>Recommendations</span>
                    </div>
                </a>
            </li>
            <li>
                <a href="/counsellor" class="sidebar-menu-button <%= activePage === 'counselor' ? 'active' : '' %>">
                    <div class="sidebar-menu-left">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                        </svg>
                        <span>AI Counselor</span>
                    </div>
                </a>
            </li>
            <li>
                <a href="/assessment" class="sidebar-menu-button <%= activePage === 'assessment' ? 'active' : '' %>">
                    <div class="sidebar-menu-left">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/>
                            <line x1="16" y1="17" x2="8" y2="17"/>
                        </svg>
                        <span>Assessment</span>
                    </div>
                    <span class="sidebar-nav-badge <%= user && user.has_assessment ? 'hidden' : '' %>" id="assessBadge">New</span>
                </a>
            </li>
            <li>
                <a href="/profile" class="sidebar-menu-button <%= activePage === 'profile' ? 'active' : '' %>">
                    <div class="sidebar-menu-left">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span>Profile</span>
                    </div>
                </a>
            </li>
        </ul>
    </nav>

    <div class="sidebar-footer">
        <div class="dropdown">
            <div class="sidebar-user" onclick="toggleDropdown('userDropdown')">
                <div class="avatar avatar-sm" id="navAvatar"><%= user && user.first_name ? user.first_name[0].toUpperCase() : user && user.email ? user.email[0].toUpperCase() : 'U' %></div>
                <div class="user-info">
                    <span class="user-name"><%= user && user.first_name ? user.first_name + ' ' + (user.last_name || '') : user && user.email ? user.email.split('@')[0] : 'Student' %></span>
                    <span class="user-role"><%= user && user.role ? user.role : 'Student' %></span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:hsl(var(--muted-foreground));flex-shrink:0">
                    <path d="m18 15-6-6-6 6"/>
                </svg>
            </div>
            <div id="userDropdown" class="dropdown-content" style="bottom: calc(100% + 0.5rem); top: auto;">
                <div class="dropdown-label">My Account</div>
                <div class="dropdown-separator"></div>
                <a href="/profile" class="dropdown-item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Profile Settings
                </a>
                <div class="dropdown-separator"></div>
                <a href="#" class="dropdown-item danger" onclick="logout(); return false;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Sign Out
                </a>
            </div>
        </div>
    </div>
</aside>
