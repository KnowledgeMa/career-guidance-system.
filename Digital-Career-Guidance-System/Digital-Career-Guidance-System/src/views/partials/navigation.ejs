<nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-40">
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-center h-16">
            <!-- Logo -->
            <a href="/dashboard" class="flex items-center space-x-2">
                <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                    <span class="text-white font-bold text-sm">DC</span>
                </div>
                <span class="font-bold text-xl text-gray-900">DCGS</span>
            </a>

            <!-- Desktop Menu -->
            <div class="hidden md:flex items-center space-x-8">
                <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:text-gray-900' %>">Dashboard</a>
                <a href="/upload" class="<%= activePage === 'upload' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:text-gray-900' %>">Upload Results</a>
                <a href="/profile" class="<%= activePage === 'profile' ? 'text-indigo-600 font-medium' : 'text-gray-600 hover:text-gray-900' %>">Profile</a>
                
                <!-- User Dropdown -->
                <div class="relative" id="user-menu">
                    <button class="flex items-center space-x-2 text-gray-700 hover:text-gray-900 focus:outline-none">
                        <div class="w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 font-medium">
                            <%= user.first_name ? user.first_name[0] : user.email[0] %>
                        </div>
                        <span class="hidden lg:block text-sm font-medium"><%= user.first_name || user.email %></span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    
                    <div class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 border border-gray-200" id="user-dropdown">
                        <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Profile Settings</a>
                        <button onclick="logout()" class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100">Logout</button>
                    </div>
                </div>
            </div>

            <!-- Mobile Menu Button -->
            <button class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100" onclick="toggleMobileMenu()">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div class="hidden md:hidden border-t border-gray-200" id="mobile-menu">
        <div class="px-2 pt-2 pb-3 space-y-1">
            <a href="/dashboard" class="block px-3 py-2 rounded-md text-base font-medium <%= activePage === 'dashboard' ? 'bg-indigo-50 text-indigo-700' : 'text-gray-700 hover:bg-gray-50' %>">Dashboard</a>
            <a href="/upload" class="block px-3 py-2 rounded-md text-base font-medium <%= activePage === 'upload' ? 'bg-indigo-50 text-indigo-700' : 'text-gray-700 hover:bg-gray-50' %>">Upload Results</a>
            <a href="/profile" class="block px-3 py-2 rounded-md text-base font-medium <%= activePage === 'profile' ? 'bg-indigo-50 text-indigo-700' : 'text-gray-700 hover:bg-gray-50' %>">Profile</a>
            <button onclick="logout()" class="block w-full text-left px-3 py-2 rounded-md text-base font-medium text-red-600 hover:bg-red-50">Logout</button>
        </div>
    </div>
</nav>
