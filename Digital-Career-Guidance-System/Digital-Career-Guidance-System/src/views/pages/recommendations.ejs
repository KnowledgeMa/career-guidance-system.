                            <a href="/profile" class="dropdown-item">Profile</a>
                            <div class="dropdown-separator"></div>
                            <a href="#" class="dropdown-item danger" onclick="logout(); return false;">Sign Out</a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="dashboard-content">
                <!-- Welcome Section -->
                <section class="welcome-section">
                    <div class="dashboard-header">
                        <div>
                            <!-- <h2 class="dashboard-title">Dashboard</h2> -->
                            <p class="dashboard-subtitle">Welcome back, <strong><%= user.first_name || 'Student' %></strong> — here's your career readiness overview.</p>
                        </div>
                        <div class="dashboard-actions">
                            <a href="/upload" class="button button-outline button-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                Upload Results
                            </a>
                            <a href="/assessment" class="button button-primary button-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                Take Assessment
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Insights Panel -->
                <div id="insights-container"></div>

                <!-- Loading State -->
                <div class="loading-state" id="loading">
                    <div class="loading-spinner"></div>
                    <p>Finding your best course matches...</p>
                </div>

                <!-- Courses Grid -->
                <div class="courses-grid" id="courses-container"></div>

                <!-- Load More -->
                <div class="load-more-container">
                    <button id="load-more-btn" class="load-more-btn" style="display: none;" onclick="loadMatches()">
                        Load More Courses
                    </button>
                </div>
            </div>
        </main>

        <!-- Course Details Modal -->
        <div id="course-modal" class="modal-overlay" style="display: none;">
            <div class="modal-content">
                <div id="modal-loading" class="modal-loading" style="display: none;">
                    <div class="spinner"></div>
                    <p>Loading course details...</p>
                </div>
                <div id="modal-error" class="modal-error" style="display: none;"></div>
                <div class="modal-header">
                    <div class="modal-title-section">
                        <h2 id="modal-course-title">Course Details</h2>
                        <div class="modal-subtitle">
                            <span id="modal-university-name"></span>
                            <span class="modal-faculty" id="modal-faculty"></span>
                        </div>
                    </div>
                    <button class="modal-close" onclick="closeCourseModal()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="modal-body">
                    <!-- Course Overview -->
                    <div class="modal-section">
                        <h3 class="section-title">Course Overview</h3>
                        <div class="overview-grid">
                            <div class="overview-item">
                                <div class="overview-label">Duration</div>
                                <div class="overview-value" id="modal-duration"></div>
                            </div>
                            <div class="overview-item">
                                <div class="overview-label">NQF Level</div>
                                <div class="overview-value" id="modal-nqf-level"></div>
                            </div>
                            <div class="overview-item">
                                <div class="overview-label">Course Code</div>
                                <div class="overview-value" id="modal-course-code"></div>
                            </div>
                        </div>
                        <div class="course-description" id="modal-description"></div>
                    </div>

                    <!-- Admission Requirements -->
                    <div class="modal-section">
                        <h3 class="section-title">Admission Requirements</h3>
                        <div class="requirements-grid">
                            <div class="requirement-card">
                                <div class="requirement-header">
                                    <div class="requirement-icon"><i class="fa-solid fa-arrow-up-right-dots"></i></div>
                                    <div class="requirement-title">APS Score</div>
                                </div>
                                <div class="requirement-content">
                                    <div class="aps-info">
                                        <div class="aps-main">Minimum APS: <strong id="modal-base-aps"></strong></div>
                                        <div class="aps-note" id="modal-math-penalty" style="display: none;">
                                            Mathematical Literacy penalty: +<span id="modal-penalty-points"></span> points
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="requirement-card">
                                <div class="requirement-header">
                                    <div class="requirement-icon"><i class="fa-regular fa-bookmark"></i></div>
                                    <div class="requirement-title">Subject Requirements</div>
                                </div>
                                <div class="requirement-content">
                                    <div id="modal-subject-requirements" class="subject-requirements-list">
                                        <!-- Subject requirements will be populated here -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Career Outcomes -->
                    <div class="modal-section" id="career-outcomes-section" style="display: none;">
                        <h3 class="section-title">Career Outcomes</h3>
                        <div id="modal-career-outcomes" class="career-outcomes-list">
                            <!-- Career outcomes will be populated here -->
                        </div>
                    </div>

                    <!-- University Information -->
                    <div class="modal-section">
                        <h3 class="section-title">University Information</h3>
                        <div class="university-info">
                            <div class="university-details">
                                <div class="university-item">
                                    <span class="university-label">Institution:</span>
                                    <span id="modal-full-university-name"></span>
                                </div>
                                <div class="university-item">
                                    <span class="university-label">Province:</span>
                                    <span id="modal-province"></span>
                                </div>
                                <div class="university-item">
                                    <span class="university-label">APS Method:</span>
                                    <span id="modal-aps-method"></span>
                                </div>
                                <div class="university-item" id="university-website-item" style="display: none;">
                                    <span class="university-label">Website:</span>
                                    <a id="modal-website" href="#" target="_blank" class="university-link">Visit Website</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="modal-btn secondary" onclick="closeCourseModal()">Close</button>
                    <button class="modal-btn primary" id="modal-apply-btn" style="display: none;">Apply Now</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ── State ────────────────────────────────────────────────────────────
        let currentOffset = 0;
        let isLoading = false;

        // Server-rendered data
        const userData = <%- JSON.stringify(user || {}) %>;

        // ── CSRF helper ──────────────────────────────────────────────────────
        function getCsrfToken() {
            const meta = document.querySelector('meta[name="csrf-token"]');
            return meta ? (meta.getAttribute('content') || '') : '';
        }

        // ── Authentication & Token Refresh ────────────────────────────────────
        async function fetchWithAuth(url, options = {}) {
            const headers = {
                ...options.headers,
                'x-csrf-token': getCsrfToken()
            };

            if (options.body instanceof FormData) {
                delete headers['Content-Type'];
            }

            const tryRequest = async () => {
                return fetch(url, {
                    ...options,
                    credentials: 'include',
                    headers
                });
            };

            let response = await tryRequest();

            if (response.status === 401) {
                const errorData = await response.json().catch(() => ({}));

                if (errorData.code === 'TOKEN_EXPIRED' || errorData.error?.includes('expired')) {
                    console.log('[AUTH] Access token expired, attempting refresh...');
                    const refreshed = await refreshAccessToken();

                    if (refreshed) {
                        response = await tryRequest();
                    } else {
                        console.error('[AUTH] Token refresh failed, redirecting to login');
                        window.location.href = '/?session=expired';
                        return Promise.reject(new Error('Session expired'));
                    }
                }
            }

            return response;
        }

        async function refreshAccessToken() {
            try {
                const response = await fetch('/api/auth/refresh', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'x-csrf-token': getCsrfToken() }
                });

                if (response.ok) {
                    console.log('[AUTH] Token refreshed successfully');
                    return true;
                } else {
                    console.error('[AUTH] Token refresh failed:', await response.text());
                    return false;
                }
            } catch (err) {
                console.error('[AUTH] Refresh error:', err);
                return false;
            }
        }

        // ── Bootstrap (runs once DOM is ready) ──────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            // Close dropdown when clicking outside
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.dropdown')) {
                    const dropdown = document.getElementById('profile-dropdown');
                    if (dropdown) dropdown.classList.remove('active');
                }
            });
        });

        // ── Nav helpers ──────────────────────────────────────────────────────
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('open');
        }

        function toggleDropdown(dropdownId) {
            const dropdown = document.getElementById(dropdownId);
            const isVisible = dropdown.classList.contains('active');
            dropdown.classList.toggle('active', !isVisible);
        }

        async function logout() {
            try {
                const res = await fetchWithAuth('/api/auth/logout', {
                    method: 'POST'
                });
                if (res.ok) window.location.href = '/';
            } catch (err) {
                console.error('Logout failed:', err);
            }
        }

        // ── Render Course Card (Clean Design) ───────────────────────────────
        function renderCourseCard(match) {
            const isEligible = match.eligibility_status === 'ELIGIBLE';
            const isConditional = match.eligibility_status === 'CONDITIONAL';
            const isMissing = match.eligibility_status === 'MISSING_REQUIREMENTS';

            // Determine badge style
            let badgeClass = 'badge-missing';
            if (isEligible) badgeClass = 'badge-eligible';
            else if (isConditional) badgeClass = 'badge-conditional';
            else if (isMissing) badgeClass = 'badge-missing';

            // Get status text
            const statusText = match.eligibility_status.replace('_', ' ');

            // Build APS display
            const apsComparison = match.calculated_aps;
            let apsDisplay = '';
            if (apsComparison?.final_aps) {
                apsDisplay = `<div class="aps-display">
                    <span>Your APS: <strong class="aps-score">${apsComparison.final_aps}</strong></span>
                    ${apsComparison?.required_aps ? `<span>Required: ${apsComparison.required_aps}</span>` : ''}
                </div>`;
            }

            // Build clean card with click handler
            return `
                <div class="course-card" onclick="openCourseModal('${match.course_id}')">
                    <div class="course-card-top">
                        <div class="course-card-icon"><i class="fa-solid fa-graduation-cap"></i></div>
                        <span class="badge ${badgeClass}">${statusText}</span>
                    </div>

                    <div>
                        <div class="course-card-title">${match.course_name}</div>
                        <div class="course-card-university">${match.university_name || 'University'}</div>
                        <p class="course-card-desc">${match.narrative_reason || 'This course matches your qualifications and interests.'}</p>
                        ${apsDisplay}
                    </div>

                    <div class="course-card-footer">
                        <span style="font-size:0.8125rem;color:hsl(var(--muted-foreground))">View details →</span>
                        <svg class="course-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </div>
                </div>
            `;
        }

        // ── Render Insights Panel (Clean Design) ────────────────────────────
        function renderInsights(categorized, studentSummary) {
            const container = document.getElementById('insights-container');
            if (!container) return;

            let html = '<div class="insights-panel">';

            // Header
            html += `
                <div class="insights-header">
                    <div class="insights-icon"><i class="fa-solid fa-arrow-up-right-dots"></i></div>
                    <div class="insights-title">Your Profile Summary</div>
                </div>
            `;

            // Content
            html += '<div class="insights-content">';

            // APS Range
            if (studentSummary?.aps_range) {
                html += `<p><strong>Your APS Range:</strong> ${studentSummary.aps_range}</p>`;
            }

            // Math Status
            const hasCoreMath = studentSummary?.has_core_math;
            const hasTechMath = studentSummary?.has_tech_math;
            const hasMathLit = studentSummary?.has_math_lit;

            if (hasCoreMath) {
                html += `
                    <div class="insights-highlight">
                        <i class="fa-regular fa-circle-check"></i> Core Mathematics detected - All courses available
                    </div>
                `;
            } else if (hasTechMath) {
                html += `
                    <div class="insights-highlight">
                        <i class="fa-solid fa-exclamation"></i> Technical Mathematics detected - Limited to specific faculties
                    </div>
                `;
            } else if (hasMathLit) {
                html += `
                    <div class="insights-highlight">
                        <i class="fa-solid fa-exclamation"></i> Mathematical Literacy detected - Many courses require core Mathematics
                    </div>
                `;
            }

            html += '</div></div>';
            container.innerHTML = html;
        }

        // ── Render Empty State (Clean Design) ───────────────────────────────
        function renderEmptyState(categorized, studentSummary) {
            const container = document.getElementById('courses-container');

            let html = '<div class="empty-state">';
            html += '<div class="empty-state-icon"><i class="fa-solid fa-user-graduate"></i></div>';
            html += '<h3 class="empty-state-title">No matching courses found</h3>';

            const hasMathLit = studentSummary?.has_math_lit;
            const hasCoreMath = studentSummary?.has_core_math;

            if (hasMathLit && !hasCoreMath) {
                html += `
                    <p class="empty-state-desc">You have Mathematical Literacy, but most courses require core Mathematics.</p>
                    <div class="empty-options">
                        <div class="empty-options-title">Your Options:</div>
                        <ul class="empty-options-list">
                            <li>Upgrade to core Mathematics at a TVET college or night school</li>
                            <li>Search for courses specifically accepting Mathematical Literacy</li>
                            <li>Consider UNISA or distance learning programs with different requirements</li>
                            <li>Explore Diploma programs with lower Math requirements</li>
                        </ul>
                    </div>
                `;
            } else {
                html += '<p class="empty-state-desc">Try uploading your results or adjusting filters to see more options.</p>';
            }

            html += '</div>';
            container.innerHTML = html;
        }

        // ── Main Load Function ───────────────────────────────────────────────
        async function loadMatches() {
            if (isLoading) return;
            isLoading = true;

            const container = document.getElementById('courses-container');
            const loading = document.getElementById('loading');
            const loadBtn = document.getElementById('load-more-btn');

            loading.style.display = 'block';
            loading.innerHTML = `
                <div class="loading-spinner"></div>
                <p>${currentOffset === 0 ? 'Finding your best matches...' : 'Scanning more courses...'}</p>
            `;
            loadBtn.style.display = 'none';

            try {
                const res = await fetchWithAuth(`/api/recommendations/matches?limit=20&offset=${currentOffset}`, {
                    credentials: 'include',
                    headers: { 'x-csrf-token': getCsrfToken() }
                });

                if (!res.ok) {
                    const error = await res.text();
                    throw new Error(error || 'Failed to load matches');
                }

                const data = await res.json();

                loading.style.display = 'none';
                isLoading = false;

                // Handle message (no results uploaded)
                if (data.message) {
                    renderEmptyState(data.categorized, data.student_summary);
                    return;
                }

                // Handle empty matches after filtering
                if (data.matches.length === 0 && currentOffset === 0) {
                    renderEmptyState(data.categorized, data.student_summary);
                    return;
                }

                // Render matches (eligible + conditional)
                const matchesHtml = data.matches.map(renderCourseCard).join('');
                container.innerHTML += matchesHtml;

                // Render insights panel (only on first load)
                if (currentOffset === 0) {
                    renderInsights(data.categorized, data.student_summary);
                }

                currentOffset = data.nextOffset;

                // Update load more button
                if (data.hasMore) {
                    loadBtn.style.display = 'inline-flex';
                } else {
                    loadBtn.style.display = 'none';
                    if (currentOffset > 0) {
                        container.insertAdjacentHTML('beforeend',
                            '<p class="scan-complete">Finished scanning available courses.</p>'
                        );
                    }
                }

            } catch (err) {
                console.error('Failed to load matches:', err);
                loading.innerHTML = '<p>Error loading matches. Please refresh.</p>';
                loading.style.color = 'hsl(var(--destructive))';
                isLoading = false;
            }
        }

        // ── Modal Functions ──────────────────────────────────────────────────
        async function openCourseModal(courseId) {
            console.log('[COURSE MODAL] Loading details for', courseId);
            const modal = document.getElementById('course-modal');
            const modalBody = modal.querySelector('.modal-body');
            const modalFooter = modal.querySelector('.modal-footer');
            const loadingOverlay = document.getElementById('modal-loading');
            const errorBox = document.getElementById('modal-error');

            errorBox.style.display = 'none';
            errorBox.textContent = '';
            loadingOverlay.style.display = 'flex';
            modalBody.style.display = 'none';
            if (modalFooter) modalFooter.style.display = 'none';

            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';

            try {
                const response = await fetchWithAuth(`/api/recommendations/course/${courseId}`);
                if (!response.ok) {
                    const errorText = await response.text().catch(() => 'Failed to load course details');
                    throw new Error(`Failed to load course details (${response.status}): ${errorText}`);
                }

                const data = await response.json();
                loadingOverlay.style.display = 'none';
                modalBody.style.display = '';
                if (modalFooter) modalFooter.style.display = '';
                renderCourseModal(data);
            } catch (error) {
                console.error('Error loading course details:', error);
                const message = error.message || 'Failed to load course details. Please try again.';
                loadingOverlay.style.display = 'none';
                errorBox.style.display = 'block';
                errorBox.textContent = message;
            }
        }

        function closeCourseModal() {
            const modal = document.getElementById('course-modal');
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }

        function renderCourseModal(data) {
            const { course, university, requirements } = data;

            // Update modal header
            document.getElementById('modal-course-title').textContent = course.name;
            document.getElementById('modal-university-name').textContent = university.name;
            document.getElementById('modal-faculty').textContent = course.faculty;

            // Update overview
            document.getElementById('modal-duration').textContent = course.duration_years ? `${course.duration_years} years` : 'N/A';
            document.getElementById('modal-nqf-level').textContent = course.nqf_level || 'N/A';
            document.getElementById('modal-course-code').textContent = course.code || 'N/A';
            document.getElementById('modal-description').textContent = course.description || 'No description available.';

            // Update APS requirements
            document.getElementById('modal-base-aps').textContent = requirements.base_min_aps;
            const penaltyDiv = document.getElementById('modal-math-penalty');
            const penaltyPoints = document.getElementById('modal-penalty-points');
            if (requirements.math_lit_aps_penalty && requirements.math_lit_aps_penalty > 0) {
                penaltyPoints.textContent = requirements.math_lit_aps_penalty;
                penaltyDiv.style.display = 'block';
            } else {
                penaltyDiv.style.display = 'none';
            }

            // Update subject requirements
            const subjectReqContainer = document.getElementById('modal-subject-requirements');
            if (requirements.subject_requirements && requirements.subject_requirements.length > 0) {
                const subjectHtml = requirements.subject_requirements.map(req => {
                    const levelText = req.min_level ? `Level ${req.min_level}+` : 'Any level';
                    const altText = req.alternative && req.alt_min_level ? ` or ${req.alternative} Level ${req.alt_min_level}+` : '';
                    const requiredClass = req.required !== false ? 'subject-required' : 'subject-optional';
                    const requiredText = req.required !== false ? 'Required' : 'Recommended';

                    return `
                        <div class="subject-requirement">
                            <div>
                                <div class="subject-name">${req.subject}${altText}</div>
                                <div class="subject-level">${levelText}</div>
                            </div>
                            <span class="${requiredClass}">${requiredText}</span>
                        </div>
                    `;
                }).join('');
                subjectReqContainer.innerHTML = subjectHtml;
            } else {
                subjectReqContainer.innerHTML = '<p style="color: hsl(var(--muted-foreground)); font-style: italic;">No specific subject requirements listed.</p>';
            }

            // Update career outcomes
            const careerSection = document.getElementById('career-outcomes-section');
            const careerContainer = document.getElementById('modal-career-outcomes');
            if (course.career_outcomes && course.career_outcomes.length > 0) {
                const careerHtml = course.career_outcomes.map(outcome => `
                    <div class="career-outcome">${outcome}</div>
                `).join('');
                careerContainer.innerHTML = careerHtml;
                careerSection.style.display = 'block';
            } else {
                careerSection.style.display = 'none';
            }

            // Update university information
            document.getElementById('modal-full-university-name').textContent = university.name;
            document.getElementById('modal-province').textContent = university.province || 'N/A';
            const websiteItem = document.getElementById('university-website-item');
            const websiteLink = document.getElementById('modal-website');
            const apsMethod = university.aps_calculation_method ? university.aps_calculation_method.replace(/_/g, ' ').toUpperCase() : 'N/A';
            document.getElementById('modal-aps-method').textContent = apsMethod;

            if (university.website) {
                websiteLink.href = university.website;
                websiteLink.textContent = university.website.replace(/^https?:\/\//, '');
                websiteItem.style.display = 'flex';
            } else {
                websiteItem.style.display = 'none';
            }
        }

        // ── Close modal on escape key ────────────────────────────────────────
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeCourseModal();
            }
        });

        // ── Close modal when clicking overlay ───────────────────────────────
        document.getElementById('course-modal').addEventListener('click', (e) => {
            if (e.target.id === 'course-modal') {
                closeCourseModal();
            }
        });

        // Initial Load
        loadMatches();
    </script>
</body>
</html>
        
