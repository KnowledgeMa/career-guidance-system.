                            <p class="hero-desc">Ready to discover your perfect career path? Upload your matric results, take our RIASEC assessment, and get personalised university recommendations.</p>
                            <div class="hero-buttons">
                                <a href="/upload" class="btn-hero-primary">Upload Results</a>
                                <a href="/assessment" class="btn-hero-outline">Take Assessment</a>
                            </div>
                        </div>
                        <div class="hero-graphic" id="heroPills">
                            <!-- Populated by JS with live data -->
                        </div>
                    </div>
                </section>

                <!-- Alert -->
                <div class="alert alert-error" id="errorAlert">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span id="errorMessage">Something went wrong. Please try again.</span>
                </div>

                <!-- Steps -->
                <section class="steps-section" style="display: none;">
                    <div class="steps" id="steps">
                        <div class="step active" data-step="1">
                            <div class="step-number">1</div>
                            <span class="step-label">Upload</span>
                        </div>
                        <div class="step" data-step="2">
                            <div class="step-number">2</div>
                            <span class="step-label">Processing</span>
                        </div>
                        <div class="step" data-step="3">
                            <div class="step-number">3</div>
                            <span class="step-label">Review</span>
                        </div>
                        <div class="step" data-step="4">
                            <div class="step-number">4</div>
                            <span class="step-label">Confirm</span>
                        </div>
                    </div>
                </section>

                <!-- Upload Zone -->
                <section class="upload-section">
                    <div class="upload-zone" id="uploadZone">
                        <div class="upload-icon"><i class="fa-solid fa-file-arrow-up"></i></div>
                        <h2 class="upload-title">Drop your report card here</h2>
                        <p class="upload-desc">or click to browse from your device</p>
                        <p class="upload-hint">Supports: JPG, PNG, PDF (max 10MB)</p>
                        <input type="file" class="file-input" id="fileInput" accept=".jpg,.jpeg,.png,.pdf">
                    </div>
                </section>

                <!-- Preview Section -->
                <section class="preview-section">
                    <div class="preview-card" id="previewCard">
                        <div class="preview-header">
                            <div class="file-info">
                                <div class="file-icon" id="fileIcon"><i class="fa-solid fa-file-arrow-up"></i></div>
                                <div class="file-details">
                                    <h3 id="fileName">filename.jpg</h3>
                                    <p id="fileSize">2.5 MB</p>
                                </div>
                            </div>
                            <button class="btn-remove" onclick="removeFile()">Remove</button>
                        </div>
                        <button class="button button-primary" onclick="startUpload()" id="uploadBtn">
                            Process Report Card
                        </button>
                    </div>
                </section>

                <!-- Processing Section -->
                <section class="processing-section">
                    <div class="processing-card" id="processingCard">
                        <div class="processing-spinner"></div>
                        <h2 class="processing-title">Processing your report card...</h2>
                        <p class="processing-desc">Our AI is extracting your subjects and marks. This may take a few moments.</p>
                        <div class="progress-bar">
                            <div class="progress-fill" id="progressFill" style="width: 5%"></div>
                        </div>
                    </div>
                </section>

                <!-- Error Section -->
                <section class="error-section">
                    <div class="error-card" id="errorCard">
                        <div class="error-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                        <h3 class="error-title">Processing Failed</h3>
                        <p class="error-desc" id="errorDetails">We couldn't read your report card. Please try uploading a clearer image.</p>
                        <button class="button button-secondary" onclick="resetUpload()">Try Again</button>
                    </div>
                </section>

                <!-- Results Section -->
                <section class="results-section">
                    <div class="results-card" id="resultsCard">
                        <div class="results-header">
                            <div>
                                <h2 class="results-title">Extracted Results</h2>
                                <p style="color: hsl(var(--muted-foreground));">Review and edit if needed, then confirm to save.</p>
                            </div>
                            <div class="aps-badge">
                                <div class="aps-label">APS Score (Best 6)</div>
                                <div class="aps-value" id="apsValue">--</div>
                            </div>
                        </div>

                        <table class="subject-table">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Mark (%)</th>
                                    <th>Level</th>
                                    <th>APS Points</th>
                                </tr>
                            </thead>
                            <tbody id="subjectsTable">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>

                        <div class="form-actions">
                            <button class="button button-secondary" onclick="resetUpload()">Upload Different File</button>
                            <button class="button button-primary" onclick="confirmResults()" id="confirmBtn">
                                Confirm & Save Results
                            </button>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <script>
        // ── State ────────────────────────────────────────────────────────────
        let currentFile   = null;
        let uploadId      = null;
        let extractedData = null;
        let pollInterval  = null;
        let progressValue = 5;
        let progressTimer = null;

        // Server-rendered data
        const userData = <%- JSON.stringify(user || {}) %>;

        // ── CSRF helper ──────────────────────────────────────────────────────
        function getCsrfToken() {
            const meta = document.querySelector('meta[name="csrf-token"]');
            return meta ? (meta.getAttribute('content') || '') : '';
        }

        function jsonHeaders() {
            return {
                'Content-Type': 'application/json',
                'x-csrf-token': getCsrfToken()
            };
        }

        // ── fileInput helper ─────────────────────────────────────────────────
        function getFileInput() {
            return document.getElementById('fileInput');
        }

        // ── Authentication & Token Refresh ────────────────────────────────────
        async function fetchWithAuth(url, options = {}) {
            const headers = {
                ...options.headers,
                'x-csrf-token': getCsrfToken()
            };

            if (options.body instanceof FormData) {
                delete headers['Content-Type'];
            }

            const tryRequest = async () => {
                return fetch(url, {
                    ...options,
                    credentials: 'include',
                    headers
                });
            };

            let response = await tryRequest();

            if (response.status === 401) {
                const errorData = await response.json().catch(() => ({}));

                if (errorData.code === 'TOKEN_EXPIRED' || errorData.error?.includes('expired')) {
                    console.log('[AUTH] Access token expired, attempting refresh...');
                    const refreshed = await refreshAccessToken();

                    if (refreshed) {
                        response = await tryRequest();
                    } else {
                        console.error('[AUTH] Token refresh failed, redirecting to login');
                        window.location.href = '/?session=expired';
                        return Promise.reject(new Error('Session expired'));
                    }
                }
            }

            return response;
        }

        async function refreshAccessToken() {
            try {
                const response = await fetch('/api/auth/refresh', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'x-csrf-token': getCsrfToken() }
                });

                if (response.ok) {
                    console.log('[AUTH] Token refreshed successfully');
                    return true;
                } else {
                    console.error('[AUTH] Token refresh failed:', await response.text());
                    return false;
                }
            } catch (err) {
                console.error('[AUTH] Refresh error:', err);
                return false;
            }
        }

        // ── Bootstrap (runs once DOM is ready) ──────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            // Upload-zone: open file picker on click
            const zone = document.getElementById('uploadZone');

            zone.addEventListener('click', () => {
                getFileInput().click();
            });

            zone.addEventListener('dragover', (e) => {
                e.preventDefault();
                zone.classList.add('dragover');
            });

            zone.addEventListener('dragleave', () => {
                zone.classList.remove('dragover');
            });

            zone.addEventListener('drop', (e) => {
                e.preventDefault();
                zone.classList.remove('dragover');
                if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
            });

            document.addEventListener('change', (e) => {
                if (e.target && e.target.id === 'fileInput') {
                    if (e.target.files.length) handleFile(e.target.files[0]);
                }
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.dropdown')) {
                    const dropdown = document.getElementById('profile-dropdown');
                    if (dropdown) dropdown.classList.remove('active');
                }
            });
        });

        // ── Nav helpers ──────────────────────────────────────────────────────
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('open');
        }

        function toggleDropdown(dropdownId) {
            const dropdown = document.getElementById(dropdownId);
            const isVisible = dropdown.classList.contains('active');
            dropdown.classList.toggle('active', !isVisible);
        }

        async function logout() {
            try {
                const res = await fetchWithAuth('/api/auth/logout', {
                    method: 'POST'
                });
                if (res.ok) window.location.href = '/';
            } catch (err) {
                console.error('Logout failed:', err);
            }
        }

        // ── File handling ────────────────────────────────────────────────────
        function handleFile(file) {
            const allowed = ['image/jpeg', 'image/png', 'image/jpg', 'application/pdf'];
            if (!allowed.includes(file.type)) {
                showError('Invalid file type. Please upload JPG, PNG, or PDF.');
                return;
            }
            if (file.size > 10 * 1024 * 1024) {
                showError('File too large. Maximum size is 10MB.');
                return;
            }

            currentFile = file;
            document.getElementById('fileName').textContent = file.name;
            document.getElementById('fileSize').textContent = formatFileSize(file.size);
            document.getElementById('fileIcon').textContent =
                file.type === 'application/pdf' ? '📑' : '🖼️';

            document.getElementById('uploadZone').classList.add('hidden');
            document.getElementById('previewCard').classList.add('active');
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        function refreshFileInput() {
            const old = getFileInput();
            if (!old) return;
            const fresh = old.cloneNode(false);
            old.parentNode.replaceChild(fresh, old);
        }

        function removeFile() {
            currentFile = null;
            refreshFileInput();
            document.getElementById('uploadZone').classList.remove('hidden');
            document.getElementById('previewCard').classList.remove('active');
        }

        function resetUpload() {
            currentFile   = null;
            uploadId      = null;
            extractedData = null;

            if (pollInterval)  { clearInterval(pollInterval);  pollInterval  = null; }
            if (progressTimer) { clearInterval(progressTimer); progressTimer = null; }

            refreshFileInput();

            document.getElementById('uploadZone').classList.remove('hidden');
            document.getElementById('previewCard').classList.remove('active');
            document.getElementById('processingCard').classList.remove('active');
            document.getElementById('resultsCard').classList.remove('active');
            document.getElementById('errorCard').classList.remove('active');

            progressValue = 5;
            document.getElementById('progressFill').style.width = '5%';

            updateStep(1);
        }

        // ── UI helpers ───────────────────────────────────────────────────────
        function updateStep(step) {
            document.querySelectorAll('.step').forEach(s => {
                const n = parseInt(s.dataset.step);
                s.classList.remove('active', 'completed');
                if (n === step) s.classList.add('active');
                if (n < step)  s.classList.add('completed');
            });
        }

        function showError(message) {
            document.getElementById('errorMessage').textContent = message;
            const alert = document.getElementById('errorAlert');
            alert.classList.add('active');
            setTimeout(() => alert.classList.remove('active'), 5000);
        }

        function startProgressAnimation() {
            progressValue = 5;
            document.getElementById('progressFill').style.width = '5%';
            progressTimer = setInterval(() => {
                const remaining = 90 - progressValue;
                progressValue += Math.max(0.5, remaining * 0.04);
                document.getElementById('progressFill').style.width =
                    Math.min(progressValue, 90) + '%';
            }, 600);
        }

        function stopProgressAnimation(finalPct) {
            if (progressTimer) { clearInterval(progressTimer); progressTimer = null; }
            document.getElementById('progressFill').style.width = (finalPct != null ? finalPct : 100) + '%';
        }

        // ── Upload & processing ──────────────────────────────────────────────
        async function startUpload() {
            if (!currentFile) {
                showError('Please select a file first.');
                return;
            }

            updateStep(2);
            document.getElementById('previewCard').classList.remove('active');
            document.getElementById('processingCard').classList.add('active');
            startProgressAnimation();

            const formData = new FormData();
            formData.append('reportCard', currentFile);

            try {
                const response = await fetchWithAuth('/api/results/upload', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Upload failed');

                uploadId = data.uploadId;
                pollInterval = setInterval(() => checkStatus(uploadId), 2000);

            } catch (err) {
                stopProgressAnimation(0);
                document.getElementById('processingCard').classList.remove('active');
                document.getElementById('errorCard').classList.add('active');
                document.getElementById('errorDetails').textContent = err.message;
            }
        }

        async function checkStatus(id) {
            try {
                const response = await fetchWithAuth(`/api/results/status/${id}`, {
                    method: 'GET'
                });

                if (!response.ok) {
                    console.warn('Status check returned', response.status);
                    return;
                }

                const data = await response.json();

                if (data.status === 'completed') {
                    clearInterval(pollInterval); pollInterval = null;
                    stopProgressAnimation(100);
                    extractedData = data;
                    displayResults(data);
                } else if (data.status === 'failed') {
                    clearInterval(pollInterval); pollInterval = null;
                    stopProgressAnimation(0);
                    document.getElementById('processingCard').classList.remove('active');
                    document.getElementById('errorCard').classList.add('active');
                    document.getElementById('errorDetails').textContent =
                        data.error || 'Processing failed. Please try a clearer image.';
                }

            } catch (err) {
                console.error('Status check failed:', err);
            }
        }

        // ── Results display & editing ────────────────────────────────────────
        function displayResults(data) {
            updateStep(3);
            document.getElementById('processingCard').classList.remove('active');
            document.getElementById('resultsCard').classList.add('active');
            document.getElementById('apsValue').textContent = data.apsScore || '--';

            const tbody = document.getElementById('subjectsTable');
            tbody.innerHTML = '';

            (data.subjects || []).forEach((subject, index) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td style="font-weight:500">${subject.subject}</td>
                    <td>
                        <input type="number" class="mark-input"
                            value="${subject.mark}" min="0" max="100"
                            onchange="updateMark(${index}, this.value)"
                            data-index="${index}">
                    </td>
                    <td>
                        <span class="level-badge level-${subject.level}" id="level-${index}">
                            Level ${subject.level}
                        </span>
                    </td>
                    <td style="font-weight:600;color:hsl(var(--primary))" id="aps-${index}">
                        ${subject.aps_points}
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function updateMark(index, newMark) {
            const mark  = Math.max(0, Math.min(100, parseInt(newMark) || 0));
            const level = calculateLevel(mark);
            const aps   = level;

            const input = document.querySelector(`input[data-index="${index}"]`);
            if (input) input.value = mark;

            document.getElementById(`level-${index}`).textContent = `Level ${level}`;
            document.getElementById(`level-${index}`).className = `level-badge level-${level}`;
            document.getElementById(`aps-${index}`).textContent = aps;

            if (extractedData && extractedData.subjects[index]) {
                extractedData.subjects[index].mark       = mark;
                extractedData.subjects[index].level      = level;
                extractedData.subjects[index].aps_points = aps;
            }

            recalculateAPS();
        }

        function calculateLevel(mark) {
            if (mark >= 80) return 7;
            if (mark >= 70) return 6;
            if (mark >= 60) return 5;
            if (mark >= 50) return 4;
            if (mark >= 40) return 3;
            if (mark >= 30) return 2;
            return 1;
        }

        function recalculateAPS() {
            if (!extractedData || !extractedData.subjects) return;
            const best6 = [...extractedData.subjects]
                .filter(s => !s.subject.toLowerCase().includes('life orientation'))
                .sort((a, b) => b.aps_points - a.aps_points)
                .slice(0, 6);
            document.getElementById('apsValue').textContent =
                best6.reduce((sum, s) => sum + s.aps_points, 0);
        }

        // ── Confirm & save ───────────────────────────────────────────────────
        async function confirmResults() {
            if (!extractedData || !extractedData.subjects) {
                showError('No results to confirm. Please upload a report card first.');
                return;
            }

            const btn = document.getElementById('confirmBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner"></span> Saving...';

            try {
                const response = await fetchWithAuth('/api/results/confirm', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        subjects: extractedData.subjects,
                        uploadId: uploadId
                    })
                });

                const data = await response.json();

                if (response.ok) {
                    updateStep(4);
                    setTimeout(() => {
                        window.location.href = '/dashboard?success=results-saved';
                    }, 1500);
                } else {
                    throw new Error(data.error || 'Failed to save results');
                }
            } catch (err) {
                btn.disabled = false;
                btn.textContent = 'Confirm & Save Results';
                showError(err.message);
            }
        }
    </script>
</body>
</html>