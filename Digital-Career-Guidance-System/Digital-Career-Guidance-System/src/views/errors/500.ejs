<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - DCGS</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; color: white; }
        h1 { font-size: 4rem; margin-bottom: 20px; }
        p { font-size: 1.2rem; margin-bottom: 30px; opacity: 0.9; }
        a { color: white; background: rgba(255,255,255,0.2); padding: 12px 30px; border-radius: 8px; text-decoration: none; }
    </style>
</head>
<body>
    <div>
        <h1>500</h1>
        <p>Something went wrong</p>
        <a href="/">Go Home</a>
    </div>
</body>
</html>
