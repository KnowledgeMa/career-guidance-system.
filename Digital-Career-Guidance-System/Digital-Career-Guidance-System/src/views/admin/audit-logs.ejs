<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Audit Logs' %> - DCGS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --background: #ffffff;
            --foreground: #0f172a;
            --card: #ffffff;
            --card-foreground: #0f172a;
            --muted: #f1f5f9;
            --muted-foreground: #64748b;
            --border: #e2e8f0;
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-foreground: #ffffff;
            --secondary: #f1f5f9;
            --secondary-foreground: #0f172a;
            --success: #10b981;
            --success-light: #d1fae5;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --danger: #ef4444;
            --danger-light: #fee2e2;
            --info: #3b82f6;
            --info-light: #dbeafe;
            --radius: 16px;
            --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--background);
            color: var(--foreground);
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        .header {
            background: var(--card);
            border-radius: var(--radius);
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
        }

        .header h1 {
            color: var(--foreground);
            margin-bottom: 0.5rem;
            font-size: 2rem;
            font-weight: 700;
        }

        .table-container {
            background: var(--card);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 1rem;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        th {
            background: var(--muted);
            font-weight: 600;
            color: var(--foreground);
            position: sticky;
            top: 0;
        }

        tr:hover {
            background: var(--muted);
        }

        .action-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
        }

        .action-update { background: var(--warning-light); color: var(--warning); }
        .action-delete { background: var(--danger-light); color: var(--danger); }
        .action-create { background: var(--success-light); color: var(--success); }

        .data-preview {
            max-width: 300px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .btn {
            padding: 0.375rem 0.75rem;
            border: none;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: background-color 0.2s ease;
            background: var(--secondary);
            color: var(--secondary-foreground);
        }

        .btn:hover { background: #e2e8f0; }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            margin-top: 2rem;
            padding: 1rem;
        }

        .pagination .btn {
            padding: 0.5rem 1rem;
            background: var(--primary);
            color: var(--primary-foreground);
        }

        .pagination .btn:hover { background: var(--primary-dark); }

        .pagination span {
            color: var(--muted-foreground);
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }

        .modal-content {
            background: var(--card);
            margin: 5% auto;
            padding: 2rem;
            border-radius: var(--radius);
            width: 90%;
            max-width: 800px;
            box-shadow: var(--shadow-lg);
            max-height: 80vh;
            overflow-y: auto;
        }

        .modal h2 {
            margin-bottom: 1rem;
        }

        .detail-section {
            margin-bottom: 1.5rem;
        }

        .detail-section h3 {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--primary);
        }

        .detail-content {
            background: var(--muted);
            padding: 1rem;
            border-radius: 8px;
            font-family: monospace;
            white-space: pre-wrap;
            font-size: 0.875rem;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            margin-top: 2rem;
        }

        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }

            .table-container {
                overflow-x: auto;
            }

            table {
                min-width: 1000px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Audit Logs</h1>
            <p>Track all administrative actions and changes.</p>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Admin</th>
                        <th>Action</th>
                        <th>Table</th>
                        <th>Record ID</th>
                        <th>Old Data</th>
                        <th>New Data</th>
                        <th>Timestamp</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% logs.forEach(log => { %>
                    <tr>
                        <td><%= log.admin_email %></td>
                        <td><span class="action-badge action-<%= log.action.toLowerCase().split('_')[0] %>"><%= log.action %></span></td>
                        <td><%= log.target_table %></td>
                        <td><%= log.target_id %></td>
                        <td class="data-preview"><%= log.old_data ? JSON.stringify(log.old_data).substring(0, 50) + '...' : 'N/A' %></td>
                        <td class="data-preview"><%= log.new_data ? JSON.stringify(log.new_data).substring(0, 50) + '...' : 'N/A' %></td>
                        <td><%= new Date(log.created_at).toLocaleString() %></td>
                        <td>
                            <button class="btn view-details-btn" data-log-id="<%= log.id %>">Details</button>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div class="pagination">
            <% if (pagination.hasPrev) { %>
                <a href="?page=<%= pagination.currentPage - 1 %>" class="btn">Previous</a>
            <% } %>
            <span>Page <%= pagination.currentPage %> of <%= pagination.totalPages %></span>
            <% if (pagination.hasNext) { %>
                <a href="?page=<%= pagination.currentPage + 1 %>" class="btn">Next</a>
            <% } %>
        </div>
        <% } %>
    </div>

    <!-- Details Modal -->
    <div id="detailsModal" class="modal">
        <div class="modal-content">
            <h2>Audit Log Details</h2>
            <div id="logDetails">
                <!-- Details will be loaded here -->
            </div>
            <div class="modal-actions">
                <button type="button" class="btn" onclick="closeModal()">Close</button>
            </div>
        </div>
    </div>

    <script>
        // View details buttons
        document.querySelectorAll('.view-details-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const logId = this.dataset.logId;
                // In a real implementation, you'd fetch the full log details
                // For now, just show a placeholder
                const detailsHtml = `
                    <div class="detail-section">
                        <h3>Log ID</h3>
                        <div class="detail-content">${logId}</div>
                    </div>
                    <div class="detail-section">
                        <h3>Full Details</h3>
                        <div class="detail-content">
                            This would show the complete audit log entry with full old_data and new_data.
                            In a production implementation, you'd fetch this data via AJAX.
                        </div>
                    </div>
                `;

                document.getElementById('logDetails').innerHTML = detailsHtml;
                document.getElementById('detailsModal').style.display = 'block';
            });
        });

        function closeModal() {
            document.getElementById('detailsModal').style.display = 'none';
        }

        // Close modal when clicking outside
        window.addEventListener('click', function(e) {
            if (e.target === document.getElementById('detailsModal')) {
                closeModal();
            }
        });
    </script>
</body>
</html>